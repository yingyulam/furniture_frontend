# Base URL of the deployed backend (NO trailing slash)
# Local dev:  http://localhost:8000
# Production: https://your-backend.onrender.com
REACT_APP_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (Google Cloud Console > Credentials)
REACT_APP_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API + Places API key (Google Cloud Console > Credentials)
REACT_APP_GOOGLE_MAP_API_KEY=

# Cloudinary unsigned upload settings (Cloudinary Dashboard + Settings > Upload preset)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
